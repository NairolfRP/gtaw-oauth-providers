{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NairolfRP/gtaw-oauth-providers.git"
  },
  "description": "Some GTA World OAuth providers for some frameworks and libraries. ",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "test": "pnpm -r test",
    "lint": "eslint --cache .",
    "format": "prettier --cache -c .",
    "format:write": "prettier --cache --write .",
    "release": "pnpm build && pnpm -r --workspace-concurrency=1 exec -- npx --no-install semantic-release -e semantic-release-monorepo --branches main --branches next",
    "release:dry": "pnpm build && pnpm -r --workspace-concurrency=1 exec -- npx --no-install semantic-release --dry-run -e semantic-release-monorepo --branches main --branches next"
  },
  "keywords": [],
  "author": {
    "name": "NairolfRP",
    "url": "https://github.com/NairolfRP"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NairolfRP/gtaw-oauth-providers/issues"
  },
  "homepage": "https://github.com/NairolfRP/gtaw-oauth-providers",
  "packageManager": "pnpm@11.14.0+sha512.66c1ac4c7d4762d6d7dde44c7f3e5a73591ed0a0806e751d4ed32d4f004f25b2285a906b1fd8a9e3e621df3b4e2858bf88e50e0cf626bedbe977fe434a5caf85",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "semantic-release-monorepo": "^8.0.2",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
